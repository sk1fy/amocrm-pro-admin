# Copy to .env for local development. Never commit .env. All values below are
# development placeholders; production values come from a secret manager.

# --- admin-api --------------------------------------------------------------
APP_ENV=development                 # development | production (Secure cookie, no dev defaults)
LOG_LEVEL=info
HTTP_ADDRESS=:8090                  # public listener (frontend proxies /api here)
MANAGEMENT_HTTP_ADDRESS=:8092       # /live, /ready, /metrics — bind loopback/internal only
SHUTDOWN_TIMEOUT=15s
DATABASE_URL=postgres://admin:admin@admin-postgres:5432/admin?sslmode=disable
DATABASE_TIMEOUT=2s
DB_MAX_CONNS=10
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:5173   # Origin check for mutating requests
SESSION_ABSOLUTE_TTL=12h
SESSION_IDLE_TTL=2h
LOGIN_RATE_PER_MINUTE=10            # per IP and per email, process-local
TRUST_PROXY_HEADERS=true            # trust proxy headers; false when the API is exposed directly
BACKENDS_FILE=/etc/admin/backends.yaml

# --- backend credentials (names referenced by deploy/backends.yaml token_env) --
CORE_ADMIN_API_TOKEN=admin-dev-token-change-me

# --- amocrm-pro `api` admin listener (set in that repository's compose) ------
# ADMIN_HTTP_ADDRESS=:8083
# ADMIN_API_TOKEN=admin-dev-token-change-me   # must equal CORE_ADMIN_API_TOKEN
# ACTIVITY_ADMIN_PORT=18083                   # host port for docker-compose.activity.yml

# --- admin-postgres (deploy/docker-compose.yml) --------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=admin
POSTGRES_PORT=5433
